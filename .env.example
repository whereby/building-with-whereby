# Copy this file to `.env` and paste your Whereby REST API key.
# Create a key at https://whereby.com under Embedded → API keys.
#
# This is a SECRET, server-to-server key. It is read only by the Vite dev
# server (see vite.config.ts) and injected into proxied requests — it is NOT
# prefixed with VITE_, so it never reaches the browser bundle. Never commit it.
WHEREBY_API_KEY=

# Your account's Whereby subdomain, e.g. "funtimes" for funtimes.whereby.com.
# This one IS public (it's in every room URL), so it's VITE_-prefixed and baked
# into the client. It lets name-only invite links (/#<roomName>) rebuild the full
# room URL. Set the same value in Netlify's environment variables for production.
VITE_WHEREBY_SUBDOMAIN=
